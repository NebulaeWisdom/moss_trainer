{
  "model_dir": "G:/ComfyUI/models/moss_image_sft_bf16",
  "dataset": {
    "image_dir": "G:/github_repo/moss_image_trainer/test_image",
    "caption": null,
    "caption_extension": ".json",
    "caption_format": "moss_official",
    "caption_dir": "G:/github_repo/moss_image_trainer/test_image_caption",
    "caption_weights": {
      "long": 1,
      "medium": 1,
      "short": 1
    },
    "resolutions": [
      768
    ],
    "bucket_step": 16,
    "max_aspect_ratio": 2.0,
    "random_crop": true,
    "bucket_mode": "resize",
    "repeats": 1,
    "caption_dropout": 0.0,
    "seed": 42
  },
  "text": {
    "max_sequence_length": 4096,
    "gpu_memory_gib": 10,
    "cpu_memory_gib": 48
  },
  "adapter": {
    "algo": "lora",
    "rank": 4,
    "alpha": 4,
    "target_modules": [
      "_Block"
    ],
    "dropout": 0.0,
    "kwargs": {}
  },
  "training": {
    "max_steps": 999999999,
    "epochs": 20,
    "batch_size": 1,
    "gradient_accumulation": 8,
    "seed": 42,
